    if(runs<=res.cfg.warnAhead&&level==="ok"){level="warn";}
    text+=` · limit ${fmtTick(+res.reach.limit.toPrecision(3))} in ≈ ${Number.isFinite(runs)?Math.round(runs):"∞"} runs`;}
