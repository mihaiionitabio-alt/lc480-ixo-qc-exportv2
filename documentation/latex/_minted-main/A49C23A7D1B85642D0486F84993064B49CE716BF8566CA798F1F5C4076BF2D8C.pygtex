\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n+nb}{Number}\PYG{p}{.}\PYG{n+nb}{isFinite}\PYG{p}{(}\PYG{n+nx}{v}\PYG{p}{))\PYGZob{}}\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{z}\PYG{o}{=}\PYG{p}{(}\PYG{n+nx}{v}\PYG{o}{\PYGZhy{}}\PYG{n+nx}{I}\PYG{p}{.}\PYG{n+nx}{cl}\PYG{p}{)}\PYG{o}{/}\PYG{n+nx}{I}\PYG{p}{.}\PYG{n+nx}{sigma}\PYG{p}{;}
\PYG{+w}{      }\PYG{n+nx}{hi}\PYG{o}{=}\PYG{n+nb}{Math}\PYG{p}{.}\PYG{n+nx}{max}\PYG{p}{(}\PYG{l+m+mf}{0}\PYG{p}{,}\PYG{n+nx}{hi}\PYG{o}{+}\PYG{n+nx}{z}\PYG{o}{\PYGZhy{}}\PYG{n+nx}{k}\PYG{p}{);}\PYG{n+nx}{lo}\PYG{o}{=}\PYG{n+nb}{Math}\PYG{p}{.}\PYG{n+nx}{max}\PYG{p}{(}\PYG{l+m+mf}{0}\PYG{p}{,}\PYG{n+nx}{lo}\PYG{o}{\PYGZhy{}}\PYG{n+nx}{z}\PYG{o}{\PYGZhy{}}\PYG{n+nx}{k}\PYG{p}{);}
\PYG{+w}{      }\PYG{n+nx}{sigHi}\PYG{o}{=}\PYG{n+nx}{hi}\PYG{o}{\PYGZgt{}}\PYG{n+nx}{h}\PYG{p}{;}\PYG{n+nx}{sigLo}\PYG{o}{=}\PYG{n+nx}{lo}\PYG{o}{\PYGZgt{}}\PYG{n+nx}{h}\PYG{p}{;\PYGZcb{}}
