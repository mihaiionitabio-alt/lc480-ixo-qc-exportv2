\PYG{+w}{  }\PYG{k}{return}\PYG{+w}{ }\PYG{l+s+sb}{`\PYGZsh{}dataset\PYGZhy{}}\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nb}{encodeURIComponent}\PYG{p}{(}\PYG{n+nb}{String}\PYG{p}{(}\PYG{n+nx}{key}\PYG{p}{).}\PYG{n+nx}{replace}\PYG{p}{(}\PYG{l+s+sr}{/[\PYGZca{}\PYGZbs{}w.\PYGZhy{}]+/g}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}\PYGZhy{}\PYGZdq{}}\PYG{p}{))}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{`}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}
