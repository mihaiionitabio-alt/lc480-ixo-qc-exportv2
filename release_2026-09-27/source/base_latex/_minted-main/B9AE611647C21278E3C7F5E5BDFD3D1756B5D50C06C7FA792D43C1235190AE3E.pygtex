\PYG{+w}{      }\PYG{p}{\PYGZob{}}\PYG{n+nx}{id}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}I04\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{when}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}negative control amplifies in a screening target\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{action}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}do not issue a sample call; reject or review the run\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{outcome}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Control fail\PYGZdq{}}\PYG{p}{\PYGZcb{},}
