\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Export history (CSV)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}导出历史（CSV）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Remember history in this browser\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}在本浏览器中保存历史\PYGZdq{}}\PYG{p}{,}
