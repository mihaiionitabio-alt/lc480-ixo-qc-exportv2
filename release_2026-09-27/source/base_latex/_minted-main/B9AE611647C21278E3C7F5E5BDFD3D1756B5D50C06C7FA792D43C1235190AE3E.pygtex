\PYG{+w}{  }\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Settling time at the denaturation step\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{source}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}as B\PYGZhy{}H1\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{n+nx}{idea}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Seconds from the 90 \PYGZpc{} point until the block stays within ±0.5 °C of the setpoint.\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{n+nx}{reading}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Longer settling with a normal ramp rate points to control tuning or sensor lag.\PYGZdq{}}\PYG{p}{\PYGZcb{},}
