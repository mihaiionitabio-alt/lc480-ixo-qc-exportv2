\PYG{c+cm}{/* \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{} the two scripts \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{} */}
\PYG{k+kd}{function}\PYG{+w}{ }\PYG{n+nx}{rScript}\PYG{p}{()\PYGZob{}}
\PYG{+w}{  }\PYG{k}{return}\PYG{+w}{ }\PYG{l+s+sb}{`\PYGZsh{} qpcR — fit the LightCycler 480 curves and compare with the stored Cq.}
\PYG{l+s+sb}{\PYGZsh{}}
\PYG{l+s+sb}{\PYGZsh{} Input : \PYGZlt{}run\PYGZgt{}\PYGZus{}qpcR\PYGZus{}curves.csv  (wide; column 1 is \PYGZdq{}Cycles\PYGZdq{}, one column per well)}
\PYG{l+s+sb}{\PYGZsh{}         \PYGZlt{}run\PYGZgt{}\PYGZus{}cq\PYGZus{}values.csv    (the Cq the instrument stored)}
\PYG{l+s+sb}{\PYGZsh{}}
\PYG{l+s+sb}{\PYGZsh{} install.packages(\PYGZdq{}qpcR\PYGZdq{})}
\PYG{l+s+sb}{library(qpcR)}

\PYG{l+s+sb}{wide \PYGZlt{}\PYGZhy{} read.csv(\PYGZdq{}REPLACE\PYGZus{}WIDE\PYGZdq{}, check.names = FALSE)}
\PYG{l+s+sb}{stopifnot(names(wide)[1] == \PYGZdq{}Cycles\PYGZdq{})   \PYGZsh{} pcrbatch() requires this exact name}

\PYG{l+s+sb}{\PYGZsh{} Fit every well with the default four\PYGZhy{}parameter log\PYGZhy{}logistic model.}
\PYG{l+s+sb}{ml \PYGZlt{}\PYGZhy{} modlist(wide, cyc = 1, fluo = 2:ncol(wide), baseline = \PYGZdq{}lin\PYGZdq{})}

\PYG{l+s+sb}{\PYGZsh{} Per\PYGZhy{}well efficiency and second\PYGZhy{}derivative\PYGZhy{}maximum Cq.}
\PYG{l+s+sb}{res \PYGZlt{}\PYGZhy{} pcrbatch(wide, cyc = 1, fluo = 2:ncol(wide), model = l4,}
\PYG{l+s+sb}{                methods = c(\PYGZdq{}sigfit\PYGZdq{}, \PYGZdq{}sliwin\PYGZdq{}), plot = FALSE)}
\PYG{l+s+sb}{write.csv(res, \PYGZdq{}qpcR\PYGZus{}results.csv\PYGZdq{}, row.names = FALSE)}

\PYG{l+s+sb}{\PYGZsh{} Compare qpcR\PYGZsq{}s cpD2 with the Cq the instrument stored.}
\PYG{l+s+sb}{stored \PYGZlt{}\PYGZhy{} read.csv(\PYGZdq{}REPLACE\PYGZus{}CQ\PYGZdq{})}
\PYG{l+s+sb}{qcp \PYGZlt{}\PYGZhy{} data.frame(}
\PYG{l+s+sb}{  column = colnames(wide)[\PYGZhy{}1],}
\PYG{l+s+sb}{  cpD2   = sapply(ml, function(m) tryCatch(efficiency(m, plot = FALSE)\PYGZdl{}cpD2,}
\PYG{l+s+sb}{                                           error = function(e) NA\PYGZus{}real\PYGZus{}))}
\PYG{l+s+sb}{)}
\PYG{l+s+sb}{qcp\PYGZdl{}well \PYGZlt{}\PYGZhy{} sub(\PYGZdq{}\PYGZca{}.*\PYGZus{}\PYGZdq{}, \PYGZdq{}\PYGZdq{}, qcp\PYGZdl{}column)}
\PYG{l+s+sb}{cmp \PYGZlt{}\PYGZhy{} merge(qcp, stored[, c(\PYGZdq{}well\PYGZdq{}, \PYGZdq{}cq\PYGZdq{})], by = \PYGZdq{}well\PYGZdq{})}
\PYG{l+s+sb}{cmp\PYGZdl{}difference \PYGZlt{}\PYGZhy{} cmp\PYGZdl{}cpD2 \PYGZhy{} cmp\PYGZdl{}cq}
\PYG{l+s+sb}{print(summary(cmp\PYGZdl{}difference))}
\PYG{l+s+sb}{write.csv(cmp, \PYGZdq{}qpcR\PYGZus{}vs\PYGZus{}stored\PYGZus{}cq.csv\PYGZdq{}, row.names = FALSE)}

\PYG{l+s+sb}{\PYGZsh{} A disagreement of a few tenths of a cycle is normal: qpcR fits a sigmoid to}
\PYG{l+s+sb}{\PYGZsh{} the raw curve while the instrument used its own baseline and threshold.}
\PYG{l+s+sb}{\PYGZsh{} A disagreement of several cycles means the curves and the Cq values did not}
\PYG{l+s+sb}{\PYGZsh{} come from the same channel, which is worth investigating before going further.}
\PYG{l+s+sb}{`}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}
\PYG{k+kd}{function}\PYG{+w}{ }\PYG{n+nx}{pyScript}\PYG{p}{()\PYGZob{}}
\PYG{+w}{  }\PYG{k}{return}\PYG{+w}{ }\PYG{l+s+sb}{`\PYGZsh{} rdmlpython / LinRegPCR — reanalyse the exported curves.}
\PYG{l+s+sb}{\PYGZsh{}}
\PYG{l+s+sb}{\PYGZsh{} Input : \PYGZlt{}run\PYGZgt{}.rdml   (RDML 1.4, written by this page)}
\PYG{l+s+sb}{\PYGZsh{}}
\PYG{l+s+sb}{\PYGZsh{} pip install lxml numpy scipy}
\PYG{l+s+sb}{\PYGZsh{} git clone \PYGZhy{}\PYGZhy{}recursive https://github.com/RDML\PYGZhy{}consortium/rdmlpython.git}
\PYG{l+s+sb}{\PYGZsh{}}
\PYG{l+s+sb}{\PYGZsh{} The \PYGZhy{}\PYGZhy{}recursive matters: the XSD schemas live in a submodule, and validate()}
\PYG{l+s+sb}{\PYGZsh{} raises OSError without them. LinRegPCR itself runs without the schemas.}

\PYG{l+s+sb}{import sys}
\PYG{l+s+sb}{sys.path.insert(0, \PYGZdq{}rdmlpython\PYGZdq{})     \PYGZsh{} adjust to your checkout}
\PYG{l+s+sb}{import rdml}

\PYG{l+s+sb}{doc = rdml.Rdml(\PYGZdq{}REPLACE\PYGZus{}RDML\PYGZdq{})}
\PYG{l+s+sb}{print(\PYGZdq{}RDML version:\PYGZdq{}, doc.version())   \PYGZsh{} expect 1.4 — LinRegPCR refuses anything older}

\PYG{l+s+sb}{for exp in doc.experiments():}
\PYG{l+s+sb}{    for run in exp.runs():}
\PYG{l+s+sb}{        result = run.linRegPCR(}
\PYG{l+s+sb}{            updateRDML=True,          \PYGZsh{} write efficiencies and N0 back into the document}
\PYG{l+s+sb}{            saveResultsCSV=True,}
\PYG{l+s+sb}{            pcrEfficiencyExl=0.05,    \PYGZsh{} exclude wells more than 5\PYGZpc{} off the group efficiency}
\PYG{l+s+sb}{            verbose=False,}
\PYG{l+s+sb}{        )}
\PYG{l+s+sb}{        csv = result.get(\PYGZdq{}resultsCSV\PYGZdq{}, \PYGZdq{}\PYGZdq{})}
\PYG{l+s+sb}{        with open(\PYGZdq{}linregpcr\PYGZus{}results.tsv\PYGZdq{}, \PYGZdq{}w\PYGZdq{}, encoding=\PYGZdq{}utf\PYGZhy{}8\PYGZdq{}) as fh:}
\PYG{l+s+sb}{            fh.write(csv)}
\PYG{l+s+sb}{        print(\PYGZdq{}wells analysed:\PYGZdq{}, max(0, len(csv.splitlines()) \PYGZhy{} 1))}

\PYG{l+s+sb}{doc.save(\PYGZdq{}reanalysed.rdml\PYGZdq{})}

\PYG{l+s+sb}{\PYGZsh{} The columns to read first are \PYGZdq{}indiv PCR eff\PYGZdq{} (per\PYGZhy{}well efficiency) and}
\PYG{l+s+sb}{\PYGZsh{} \PYGZdq{}N0 (mean eff)\PYGZdq{} (starting concentration). Wells LinRegPCR excluded carry a}
\PYG{l+s+sb}{\PYGZsh{} reason in the \PYGZdq{}excluded\PYGZdq{} column — that column is the useful QC output here,}
\PYG{l+s+sb}{\PYGZsh{} because it flags curves the instrument accepted and LinRegPCR did not.}
\PYG{l+s+sb}{`}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}

\PYG{c+cm}{/* ============================================================}
\PYG{c+cm}{   D. The export catalogue}
\PYG{c+cm}{   ============================================================ */}
