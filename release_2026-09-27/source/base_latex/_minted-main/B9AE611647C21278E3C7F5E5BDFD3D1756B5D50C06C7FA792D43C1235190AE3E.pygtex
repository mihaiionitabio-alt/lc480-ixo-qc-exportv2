\PYG{+w}{    }\PYG{n+nx}{identifier}\PYG{o}{:}\PYG{p}{[}\PYG{n+nx}{m}\PYG{p}{.}\PYG{n+nx}{UID}\PYG{o}{?}\PYG{l+s+sb}{`LightCycler experiment UID: }\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nx}{m}\PYG{p}{.}\PYG{n+nx}{UID}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{`}\PYG{o}{:}\PYG{k+kc}{null}\PYG{p}{,}\PYG{n+nx}{m}\PYG{p}{.}\PYG{n+nx}{sourceCRC32}\PYG{o}{?}\PYG{l+s+sb}{`CRC\PYGZhy{}32: }\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nx}{m}\PYG{p}{.}\PYG{n+nx}{sourceCRC32}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{`}\PYG{o}{:}\PYG{k+kc}{null}\PYG{p}{].}\PYG{n+nx}{filter}\PYG{p}{(}\PYG{n+nb}{Boolean}\PYG{p}{),}
\PYG{+w}{    }\PYG{l+s+s2}{\PYGZdq{}rdfs:comment\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}The source filename is recorded, but a local filesystem path is deliberately not published in JSON\PYGZhy{}LD.\PYGZdq{}}
\PYG{+w}{  }\PYG{p}{\PYGZcb{};}
\PYG{+w}{  }\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{out}\PYG{o}{=}\PYG{p}{[}\PYG{n+nx}{source}\PYG{p}{,}
