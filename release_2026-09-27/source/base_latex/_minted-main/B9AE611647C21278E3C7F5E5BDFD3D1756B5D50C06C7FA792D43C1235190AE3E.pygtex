\PYG{p}{\PYGZlt{}}\PYG{n+nt}{script}\PYG{p}{\PYGZgt{}}
\PYG{c+cm}{/*}
\PYG{c+cm}{ * Application design notes}
\PYG{c+cm}{ * \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{ * This single\PYGZhy{}file application is organised as three deliberately small}
\PYG{c+cm}{ * boundaries: file intake/decoding, SOP evaluation, and rendering/export.}
\PYG{c+cm}{ * Data crosses a boundary as plain validated objects. Rendering is read\PYGZhy{}only}
\PYG{c+cm}{ * with respect to the run model; imports are versioned and cancellable; and}
\PYG{c+cm}{ * failures are recorded as structured events instead of being silently}
\PYG{c+cm}{ * swallowed. The notes are kept here so the browser file remains auditable}
\PYG{c+cm}{ * without requiring a build system or a network service.}
\PYG{c+cm}{ */}
\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{DEFAULT\PYGZus{}LANG}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}en\PYGZdq{}}\PYG{p}{;}
\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{ZH\PYGZus{}TERMS}\PYG{o}{=}\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}qPCR raw values, open formats, quality control and forensics — LightCycler 480 · QuantStudio 3/5\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}qPCR 原始数据、开放格式、质量控制与取证分析 — LightCycler 480 · QuantStudio 3/5\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Reads a finished LightCycler 480 .ixo or QuantStudio 3/5 .eds experiment, hands you the numbers the instrument stored, draws them, reviews them and writes them in formats that open\PYGZhy{}source tools read directly. Nothing is uploaded; everything runs in this page.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}读取已完成的 LightCycler 480 .ixo 或 QuantStudio 3/5 .eds 实验，校验文件容器是否完整，呈现仪器保存的数值，绘图、审核，并导出为开源工具可直接读取的格式。数据不会上传，所有处理均在本页面中完成。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Drop one or more LightCycler 480 .ixo files, QuantStudio .eds files or .edt templates, or a .zip containing them. Several runs — from either instrument — can be loaded at once; the Quality review tab compares them.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}拖入一个或多个 LightCycler 480 .ixo 文件、QuantStudio .eds 文件或 .edt 模板，也可拖入包含这些文件的 .zip。可同时加载两种仪器的多个运行，并在“质量审核”中进行比较。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Drop .ixo, .eds, .edt or .zip here\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}将 .ixo、.eds、.edt 或 .zip 拖到这里\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}the curve\PYGZhy{}based exports need an .ixo or .eds file.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}基于曲线的导出需要 .ixo 或 .eds 文件。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Nothing here is recomputed. For .ixo files Cq is the stored crossing point, concentration the stored CalcConc and the call the instrument\PYGZsq{}s own. For .eds files Cq is the stored Ct, the call follows the stored amplification status, and flags, ΔCt, ΔΔCt and RQ are the analysis software\PYGZsq{}s own.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}此处不重新计算任何数值。对于 .ixo 文件，Cq 为保存的交叉点，浓度为保存的 CalcConc，判定为仪器自身结果。对于 .eds 文件，Cq 为保存的 Ct，判定依据保存的扩增状态，标记、ΔCt、ΔΔCt 与 RQ 均为分析软件自身的结果。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Download relative quantification (CSV)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}下载相对定量结果（CSV）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Relative quantification (stored)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}相对定量（保存值）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Pseudonymise sample names in downloads (controls keep their names; the original .eds path is withheld)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}下载时对样品名称进行假名化（对照保留原名；不输出 .eds 原始路径）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Download pseudonym mapping (CSV)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}下载假名对照表（CSV）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}The mapping stays on this page unless you download it. Keep it with the laboratory records, not with published data.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}对照表仅保留在本页面中，除非您主动下载。请与实验室记录一同保存，不要随公开数据发布。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}LightCycler 480: raw fluorescence as stored in the AcquisitionStore, with no smoothing and no baseline subtraction. QuantStudio: the stored Rn by default, or the stored ΔRn (with its threshold), the multicomponent signal per dye, or the raw filter\PYGZhy{}set data. Controls are drawn over ordinary samples so they stay visible.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}LightCycler 480：AcquisitionStore 中保存的原始荧光，不做平滑与基线扣除。QuantStudio：默认显示保存的 Rn，也可显示保存的 ΔRn（含阈值）、各染料的多组分信号或原始滤光片组数据。对照曲线绘制在普通样品之上，便于查看。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Signal\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}信号\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Stored curve (raw / Rn)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}保存的曲线（原始 / Rn）\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}ΔRn with threshold\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}ΔRn 与阈值\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Multicomponent (per dye)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}多组分（按染料）\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Raw filter\PYGZhy{}set data\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}原始滤光片组数据\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}All samples\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}全部样品\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Target / dye / filter\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}靶标 / 染料 / 滤光片\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Show threshold\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}显示阈值\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Run metadata, thermal program, detection channels, analysis objects and the instrument\PYGZsq{}s own replicate statistics — plus, for QuantStudio files, calibrations, software modules, target settings, flag rules, the instrument log and the block temperature trace — decoded verbatim from the file.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}运行元数据、容器完整性、热循环程序、检测通道、分析对象及仪器自身的重复统计；QuantStudio 文件另含校准、软件模块、靶标设置、标记规则、仪器日志与模块温度曲线，均按原样从文件解码。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Load one or more .ixo or .eds experiments to use this sheet.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}请先加载一个或多个 .ixo 或 .eds 实验。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Instrument family\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}仪器系列\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Container integrity\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}容器完整性\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Amp status\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}扩增状态\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Flags\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}标记\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}ΔCq\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}ΔCq\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}RQ\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}RQ\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Reference\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}参照\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Target Cq\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}靶标 Cq\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Reference Cq\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}参照 Cq\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}ΔCq mean\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}ΔCq 均值\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}ΔCq SE\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}ΔCq 标准误\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}ΔΔCq\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}ΔΔCq\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}RQ / ratio\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}RQ / 比值\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Min\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}最小值\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Max\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}最大值\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}n\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}n\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Forensic log (CSV)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}容器完整性与取证日志（CSV）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}One row per run (counts, status) and one per finding: controls, flags, replicate spread, Ct traceability, calibrations and instrument log.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}每个运行一行（校验值、计数、状态），每条发现一行：容器校验、对照、标记、重复孔离散度、Ct 可追溯性、校准与仪器日志。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}QuantStudio export layout (TXT)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}QuantStudio 导出格式（TXT）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Header, Sample Setup, Raw Data, Amplification Data, Multicomponent Data and Results, tab\PYGZhy{}delimited, following the export specification of the QuantStudio command\PYGZhy{}line guide (MAN0010409, chapter 3). For LIS/LIMS parsers that expect that layout.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}包含文件头、样品设置、原始数据、扩增数据、多组分数据与结果，制表符分隔，遵循 QuantStudio 命令行指南（MAN0010409 第 3 章）的导出规范，供期望该格式的 LIS/LIMS 解析程序使用。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Relative quantification (CSV)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}相对定量（CSV）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Stored relative\PYGZhy{}quantification results: ΔΔCt summaries with RQ and confidence limits from QuantStudio, pairing ratios from LightCycler.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}保存的相对定量结果：QuantStudio 的 ΔΔCt 汇总（含 RQ 及置信限），以及 LightCycler 的配对比值。\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}Multicomponent and raw filter data (CSV)\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}多组分与原始滤光片数据（CSV）\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{l+s+s2}{\PYGZdq{}QuantStudio only: per\PYGZhy{}dye multicomponent signal and every filter\PYGZhy{}set reading, one row per named well and cycle — the data under the stored Rn.\PYGZdq{}}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}仅限 QuantStudio：各染料的多组分信号及全部滤光片组读数，每个已命名孔位、每个循环一行，即保存的 Rn 所依据的数据。\PYGZdq{}}\PYG{p}{,}
