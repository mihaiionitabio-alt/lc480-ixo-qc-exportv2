\PYG{+w}{    }\PYG{n+nx}{purpose}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Screen extracted plant DNA for 35S and T\PYGZhy{}NOS markers with HMG or LEC as the taxon reference.\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{    }\PYG{n+nx}{steps}\PYG{o}{:}\PYG{p}{[}
\PYG{+w}{      }\PYG{p}{\PYGZob{}}\PYG{n+nx}{id}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}P01\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Sample identity and extraction linkage\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{instruction}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Keep the SC\PYGZus{} sample identifier, material code, aliquot or dilution suffix, and extraction date together. Parse DD.MM.YYYY strictly and flag a date later than the run date.\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{acceptance}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}No silent renaming; unresolved dates remain unresolved.\PYGZdq{}}\PYG{p}{\PYGZcb{},}
\PYG{+w}{      }\PYG{p}{\PYGZob{}}\PYG{n+nx}{id}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}P02\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Plate and control placement\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{instruction}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Use two technical replicates for samples and LOD controls. Use one well for NTC, matrix negatives and process blanks unless the approved procedure specifies a periodic environmental blank.\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{acceptance}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Required controls are present before sample calls are issued.\PYGZdq{}}\PYG{p}{\PYGZcb{},}
\PYG{+w}{      }\PYG{p}{\PYGZob{}}\PYG{n+nx}{id}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}P03\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Amplification and analysis\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{instruction}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Use the instrument\PYGZsq{}s declared amplification analysis and preserve the original Cq, call, curve and analysis status. A curve without a same\PYGZhy{}channel result is evidence for review, not a replacement Cq.\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{acceptance}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Amplification cycles are evaluated separately from melt acquisitions.\PYGZdq{}}\PYG{p}{\PYGZcb{},}
\PYG{+w}{      }\PYG{p}{\PYGZob{}}\PYG{n+nx}{id}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}P04\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Control review\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{instruction}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Check LOD controls against their target\PYGZhy{}specific Cq windows, reference targets for the matrix, and negative controls for absence of target amplification.\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{acceptance}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}A failed control changes the run status according to the rule action.\PYGZdq{}}\PYG{p}{\PYGZcb{},}
\PYG{+w}{      }\PYG{p}{\PYGZob{}}\PYG{n+nx}{id}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}P05\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Sample interpretation\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{instruction}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Interpret a marker only when the target result and its required reference/control evidence meet this profile. Retain inconclusive or repeat outcomes when replicate or reference evidence is incomplete.\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{acceptance}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Every outcome names the rule and retains the stored call.\PYGZdq{}}\PYG{p}{\PYGZcb{},}
\PYG{+w}{      }\PYG{p}{\PYGZob{}}\PYG{n+nx}{id}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}P06\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Reporting and traceability\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{instruction}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Review the generated sample report against the loaded experiment, record the profile name, version and SHA\PYGZhy{}256, and release only the report belonging to that analysis.\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{acceptance}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}No result is reported without an experiment and profile identity.\PYGZdq{}}\PYG{p}{\PYGZcb{}}
\PYG{+w}{    }\PYG{p}{]\PYGZcb{};}
\PYG{+w}{  }\PYG{n+nx}{p}\PYG{p}{.}\PYG{n+nx}{interpretation}\PYG{o}{=}\PYG{p}{\PYGZob{}}\PYG{n+nx}{principles}\PYG{o}{:}\PYG{p}{[}
\PYG{+w}{      }\PYG{l+s+s2}{\PYGZdq{}A detected 35S or T\PYGZhy{}NOS marker is reportable only when the required taxon reference is detected and the run controls pass.\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{      }\PYG{l+s+s2}{\PYGZdq{}A negative marker with a failed or shifted reference is not reported as negative; it is invalid or inconclusive according to the applicable rule.\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{      }\PYG{l+s+s2}{\PYGZdq{}A late signal, discordant replicate or Cq outside a control window is retained and reported with its reason.\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{      }\PYG{l+s+s2}{\PYGZdq{}The stored Cq values, calls and fluorescence traces are never changed by this profile.\PYGZdq{}}
\PYG{+w}{    }\PYG{p}{],}\PYG{n+nx}{rules}\PYG{o}{:}\PYG{p}{[}
