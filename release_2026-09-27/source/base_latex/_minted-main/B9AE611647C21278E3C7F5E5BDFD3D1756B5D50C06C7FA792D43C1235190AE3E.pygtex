\PYG{+w}{    }\PYG{p}{],}\PYG{n+nx}{reporting}\PYG{o}{:}\PYG{p}{\PYGZob{}}\PYG{n+nx}{include\PYGZus{}rule\PYGZus{}id}\PYG{o}{:}\PYG{k+kc}{true}\PYG{p}{,}\PYG{n+nx}{include\PYGZus{}reason}\PYG{o}{:}\PYG{k+kc}{true}\PYG{p}{,}\PYG{n+nx}{include\PYGZus{}stored\PYGZus{}call}\PYG{o}{:}\PYG{k+kc}{true}\PYG{p}{,}\PYG{n+nx}{release\PYGZus{}statuses}\PYG{o}{:}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}Accepted\PYGZdq{}}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}Accepted with review\PYGZdq{}}\PYG{p}{]\PYGZcb{}\PYGZcb{};}
