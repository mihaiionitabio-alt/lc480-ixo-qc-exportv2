\PYG{+w}{  }\PYG{n+nx}{title}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Overshoot at the denaturation step\PYGZdq{}}\PYG{p}{,}\PYG{n+nx}{source}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}as B\PYGZhy{}H1\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{n+nx}{idea}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Block temperature beyond the setpoint before it settles. The LC480 overshoots 4–6 °C by design, identically every cycle.\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{  }\PYG{n+nx}{reading}\PYG{o}{:}\PYG{l+s+s2}{\PYGZdq{}Watch for change, not size: a CUSUM drifting up or down means the controller or the temperature sensor has changed.\PYGZdq{}}\PYG{p}{\PYGZcb{},}
